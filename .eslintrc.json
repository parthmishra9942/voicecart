{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-undef": "warn",
    "no-dupe-keys": "error",
    "no-constant-condition": "warn",
    "no-mixed-spaces-and-tabs": "error"
  }
}